{
  "name": "agentic-workspace-reference-implementation",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "TypeScript reference implementation of an agentic engineering workspace",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @agentic-workspace/core build && pnpm --filter @agentic-workspace/cli build",
    "check": "pnpm build && pnpm -r test",
    "clean": "pnpm -r clean",
    "test": "pnpm build && pnpm -r test",
    "test:coverage": "pnpm build && pnpm -r test:coverage",
    "ws": "node packages/cli/bin/ws.js"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "dependencies": {
    "agentic-workspace-reference-implementation": "link:"
  }
}
